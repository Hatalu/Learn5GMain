# ==============================================================================
# Educational Media Hub - Environment Configuration
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Public Anon Key (Safe for browser / client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Supabase Service Role Key (NEVER expose to client; used strictly on server for admin member management)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Seed Credentials (Used only by scripts/seed.ts for initial setup)
SEED_DEV_USERNAME="Hatalu001"
SEED_DEV_PASSWORD="ตั้งรหัสผ่านที่เดายากอย่างน้อย 10 ตัวอักษร"

# (ไม่บังคับ) seed สำหรับสร้างกุญแจเซ็นโทเคน "ทดลองเล่น" ถ้าไม่ตั้ง จะใช้ค่าจาก SUPABASE_SERVICE_ROLE_KEY
# ถ้าเปลี่ยนค่านี้ ต้องรัน `npx tsx scripts/trial-pubkey.ts` แล้วอัปเดต PUBLIC_JWK ใน game-sdk/l5g-trial.js และอัปโหลดเกมใหม่ทุกเกม
TRIAL_SIGNING_SEED=""

# ระบบสมัครสมาชิก: API key ของ EasySlip (https://developer.easyslip.com) ใช้ตรวจสลิปฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามใส่ NEXT_PUBLIC_
EASYSLIP_API_KEY=""

# (ไม่บังคับ แต่แนะนำ) กันบอทด้วย Cloudflare Turnstile แบบมองไม่เห็น ใช้กับปุ่มทดลองเล่น/สมัครสมาชิก/ส่งสลิป
# สมัครฟรีที่ https://dash.cloudflare.com > Turnstile แล้วใส่ทั้งสองค่า (ถ้าไม่ใส่ ระบบข้ามการตรวจนี้)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# อีเมลชวนสมาชิกที่หมดอายุกลับมา (ส่งผ่าน Resend https://resend.com ฟรี 100 ฉบับ/วัน ต้องยืนยันโดเมนก่อน)
# ไม่ตั้ง = ระบบไม่ส่งอีเมล ส่วนอื่นทำงานปกติ
RESEND_API_KEY=""
EMAIL_FROM="สื่อการสอน 5G <hello@your-domain.com>"
# ลิงก์เว็บจริง ใช้ในลิงก์ของอีเมล
NEXT_PUBLIC_SITE_URL="https://your-site.vercel.app"
# รหัสลับของ Vercel Cron (ตั้งเป็นข้อความสุ่มยาวๆ Vercel จะส่งมากับคำขอ cron เอง คนอื่นเรียก /api/cron ไม่ได้)
CRON_SECRET=""
# (ไม่บังคับ) กุญแจลงชื่อลิงก์ยกเลิกรับอีเมล ถ้าไม่ตั้งจะใช้ค่าจาก SUPABASE_SERVICE_ROLE_KEY
EMAIL_LINK_SECRET=""
